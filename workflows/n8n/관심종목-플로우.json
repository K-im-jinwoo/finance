    },
    {
      "parameters": {
        "url": "=https://openapi.naver.com/v1/search/news.json?query={{ $json.search_query }}&display=10&start=1&sort=sim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
