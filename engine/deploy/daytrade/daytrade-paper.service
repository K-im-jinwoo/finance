[Unit]
Description=Daily paper trading collector (no real orders)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/daytrade/current
EnvironmentFile=/srv/daytrade/state/service.env
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python -B -m stock_assistant.daytrade.daemon --state-root /srv/daytrade/state
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target

