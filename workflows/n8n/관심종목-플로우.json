      "id": "a9de4b17-bd2e-47c0-b0a6-0c8a4aaa871f",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  symbol, \n  stock_name, \n  sector,\n  CASE \n    WHEN sector = '조선기자재' THEN stock_name || '+(실적|수주|공시|LNG|계약)'\n    WHEN sector = '반도체기반' THEN stock_name || '+(실적|공시|엔비디아|HBM|개발|반도체)'\n    ELSE stock_name || '+(실적|공시|계약)'\n  END as search_query\nFROM watchlist;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "17882678-90b9-4529-9b20-6cdd5823a918",
      "name": "Execute a SQL query"
    },
    {
      "parameters": {
