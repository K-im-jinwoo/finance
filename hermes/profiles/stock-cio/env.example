# Copy names only into the stock-cio profile's private .env and replace placeholders there.
# Never commit the resulting .env.
TELEGRAM_BOT_TOKEN=<botfather-token>
TELEGRAM_ALLOWED_USERS=<numeric-user-id>
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_HOME_CHANNEL=<numeric-chat-id>
STOCK_API_BASE_URL=http://127.0.0.1:9120
STOCK_API_ROLE_TOKEN_FILE=<absolute-path-to-cio-token-file>
TZ=Asia/Seoul
